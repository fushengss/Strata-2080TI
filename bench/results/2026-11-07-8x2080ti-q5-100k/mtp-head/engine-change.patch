+void fill_inputs(float* p, int cycle, int steps) {
+    for (int j = 0; j < steps; ++j) {
+        uint32_t state = 0x591223a5u + 997u * cycle + 1619u * j;
+        for (int i = 0; i < kN; ++i) {
