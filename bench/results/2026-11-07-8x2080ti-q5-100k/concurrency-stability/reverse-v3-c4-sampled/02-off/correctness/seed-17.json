  "output_text": "```python\n\"\"\"\nBounded FIFO Task Queue with priorities, cancellation, retries, and thread-safe wrapper.\n\"\"\"\n\nimport threading\nimport queue\nimport time\nimport heapq\nimport logging\nfrom collections import defaultdict\nfrom dataclasses import dataclass, field\nfrom typing import Any, Callable, Dict, List, Optional, Set, Tuple\nfrom enum import Enum, auto\nimport traceback\n\nlogging.basicConfig(level=logging.WARNING)\nlogger = logging.getLogger(__name__)\n\n\nclass TaskStatus(Enum):\n    PENDING = auto()\n    RUNNING = auto()\n    COMPLETED = auto()\n    FAILED = auto()\n    CANCELLED = auto()\n\n\n@dataclass(order=True)\nclass PrioritizedTask:\n    priority: int\n    task_id: str = field(compare=False)\n    func: Callable = field(compare=False, repr=False)\n    args: tuple = field(compare=False, repr=False, default=())\n    kwargs: dict = field(compare=False, repr=False, default_factory=dict)\n    max_retries: int = field(compare=False, default=0)\n    created_time: float = field(compare=False, default_factory=time.time)\n    cancel_event: threading.Event = field(compare=False, default_factory=threading.Event, repr=False)\n    result: Any = field(compare=False, default=None, repr=False)\n    exception: Optional[Exception] = field(compare=False, default=None, repr=False)\n    status: TaskStatus = field(compare=False, default=TaskStatus.PENDING, repr=False)\n    retry_count: int = field(compare=False, default=0, repr=False)\n\n\nclass BoundedPriorityQueue:\n    \"\"\"\n    A bounded priority queue that maintains FIFO order within the same priority level.\n    \"\"\"\n\n    def __init__(self, maxsize: int = 0):\n",
