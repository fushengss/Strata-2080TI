  "end_epoch": 1794064059.9520845,
  "output_text": "```python\n\"\"\"\nBounded FIFO task queue with priorities, cancellation, retries, and thread-safe wrapper.\n\"\"\"\n\nimport threading\nimport heapq\nimport time\nimport unittest\nfrom typing import Callable, Any, Optional, List, Tuple\nfrom dataclasses import dataclass, field\nfrom enum import Enum, auto\nfrom concurrent.futures import ThreadPoolExecutor\n\n\nclass TaskStatus(Enum):\n    PENDING = auto()\n    RUNNING = auto()\n    COMPLETED = auto()\n    CANCELLED = auto()\n    FAILED = auto()\n\n\n@dataclass(order=True)\nclass Task:\n    priority: int\n    sequence: int = field(compare=True)\n    func: Callable = field(compare=False)\n    args: tuple = field(default=(), compare=False)\n    kwargs: dict = field(default_factory=dict, compare=False)\n    task_id: str = field(default=\"\", compare=False)\n    status: TaskStatus = field(default=TaskStatus.PENDING, compare=False)\n    max_retries: int = field(default=0, compare=False)\n    retry_count: int = field(default=0, compare=False)\n    result: Any = field(default=None, compare=False)\n    exception: Optional[Exception] = field(default=None, compare=False)\n    cancelled_event: threading.Event = field(default_factory=threading.Event, compare=False)\n    completion_event: threading.Event = field(default_factory=threading.Event, compare=False)\n\n\nclass BoundedPriorityQueue:\n    \"\"\"Thread-safe bounded priority queue for tasks.\"\"\"\n\n    def __init__(self, maxsize: int = 100):\n        self._maxsize = maxsize\n        self._heap: List[Task] = []\n        self._lock = threading.Lock()\n        self._not_empty = threading.Condition(self._lock)",
