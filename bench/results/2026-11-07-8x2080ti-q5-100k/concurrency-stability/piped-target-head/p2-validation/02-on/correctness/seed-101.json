  "output_text": "```python\n\"\"\"\nBounded FIFO task queue with priorities, cancellation, retries, and thread-safe wrapper.\n\"\"\"\n\nimport threading\nimport heapq\nimport time\nimport logging\nimport functools\nfrom enum import IntEnum\nfrom typing import Any, Callable, Optional, List, Dict, Tuple\nfrom dataclasses import dataclass, field\nfrom concurrent.futures import Future\nimport uuid\n\nlogger = logging.getLogger(__name__)\n\n\nclass Priority(IntEnum):\n    \"\"\"Task priority levels. Lower value = higher priority.\"\"\"\n    HIGH = 0\n    NORMAL = 1\n    LOW = 2\n\n\n@dataclass(order=False)\nclass Task:\n    \"\"\"Represents a task in the queue.\"\"\"\n    func: Callable\n    args: Tuple\n    kwargs: Dict[str, Any]\n    priority: Priority\n    max_retries: int\n    created_at: float\n    task_id: str = field(default_factory=lambda: str(uuid.uuid4()))\n    retry_count: int = 0\n    status: str = \"PENDING\"  # PENDING, RUNNING, COMPLETED, FAILED, CANCELLED\n    future: Optional[Future] = None\n    cancellation_event: threading.Event = field(default_factory=threading.Event)\n    error: Optional[Exception] = None\n    result: Optional[Any] = None\n\n    def __lt__(self, other):\n        \"\"\"For heapq: higher priority (lower value) comes first, then by created_at.\"\"\"\n        if self.priority != other.priority:\n            return self.priority < other.priority\n        return self.created_at < other.created_at\n\n\nclass TaskQueue:\n    \"\"\"\n    A bounded FIFO task queue with priorities, cancellation, and retries.\n    \n    The queue is bounded by max_size. When full, put() blocks until space is available.\n    Tasks are processed in priority order (HIGH > NORMAL > LOW), with FIFO ordering\n    within the same priority level.\n    \n    Features:\n    - Thread-safe operations\n    - Priority-based execution\n    - Task cancellation via Event or TaskQueue.cancel()\n    - Configurable retry logic per task\n    - Graceful shutdown\n    \"\"\"\n\n    def __init__(self, max_workers: int = 4, max_size: int = 100):\n        if max_workers <= 0:\n            raise ValueError(\"max_workers must be positive\")\n        if max_size <= 0:\n            raise",
