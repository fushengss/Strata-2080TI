+++ b/docs/MULTI_GPU.md
@@ -152,9 +152,23 @@ restart. Defaults are off unless the table says otherwise.
 | `--prefill-pipe R` (or `STRATA_PREFILL_PIPE=R`) | Reads each prompt in the chunk count with the least pipeline time for b/a = R tokens. `1` evens out today's chunk count. | Opt-in. `./setup.sh --calibrate` measures it per PC and writes it to the config. |
 | `STRATA_SPLIT_RING=N` | Sets the prompt path's streamed ring to N slots (`0`: the pinned-share rule). A split uses 96 when at least 75% of the (layer, expert) pairs sit in some card's cache. | The startup line `lend sizing: ...` shows the result. |
 | `STRATA_SPLIT_CHUNK16K=1` | Keeps the 16384-token auto chunk on AMD gfx12 splits (default 8192). | |
+| `STRATA_DECODE_HEAD_GPU=D` or `D1,D2` | Experimental: the native output head on one other GPU, or two vocabulary shards for greedy solo PW2 decode. Unset or `-1`: off. | Needs `--pipeline-windows 2` and a different GPU already in the split. The original prefill, layer, draft and batch placement stays in place. Adds one head copy per selected card plus per-window buffers; refuses a head that spills to RAM. |
 | `STRATA_SPLIT_OVERLAP=1` | Overlapped hand-off between stages on different cards. | Helps AMD; no gain on NVIDIA. See [below](#overlapped-hand-off). |
 | `--split-device D1[,D2..]` | The later stages' devices (default: the next visible ones). `--layer-split K --split-device 0` runs both stages on one card; a bit-exact hand-off check, not a speed mode. | |
 
+This switch is experimental in CUDA/HIP builds and has only been validated on CUDA. It is unavailable on Metal and SYCL.
+The decode-head experiment transfers each window's final Q8_1 activation through portable pinned RAM to a separate
+stream on the chosen card. The head and sampling run there, and only picks and non-finite flags return; asking for
+logprobs copies the requested logits too. No P2P link is needed. The two PW2 window parities own separate buffers.
+Requests with a history penalty or logit bias keep the ordinary head path. With one target card, sampled PW2 requests
+without those features use their original seed and position counter there. With two target cards, only greedy
+requests use the shards; sampled requests keep the ordinary head path. Each shard returns its best token and raw
+logit, and the CPU chooses the largest value with ties going to the lowest original token id. No softmax or dot
+product is repartitioned. Row sharding requires the original quantized row layout, not an in-place repack.
+A startup line names the placement, and
+`strata decode head: ... windows offloaded` reports the actual count per PW2 request. This setting does not change
+the batch scheduler or move any prefill layers; benchmark both decode and cold prefill before using it on a server.
+
 **The resident RAM mode works on a split.** `--resident-experts` (the low-RAM mode) leaves out of the RAM copy the experts any
 card's cache holds. An adaptive swap copies the evicted expert back into RAM from the card that owns its layer. A RAM budget
 (`--resident-budget-gib`) works on a split as well ([UNSLOTH_Q4.md](UNSLOTH_Q4.md)). With `--pcie-frac 0 --adapt-every 0` the
diff --git a/include/strata/core/decode_head.hpp b/include/strata/core/decode_head.hpp
new file mode 100644
index 00000000..8b75e76a
--- /dev/null
+++ b/include/strata/core/decode_head.hpp
@@ -0,0 +1,70 @@
+#pragma once
+
+#include "strata/kernels/sampler.hpp"
+
+#include <cuda_runtime.h>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+class NativeHead;
+
+/// Merge shard-local argmax results after converting their ids to global vocabulary ids. Scores are unchanged
+/// logits, not probabilities. NaN/-inf provide no candidate; equal values (including +/-0) choose the lowest id.
+int32_t decode_head_merge_argmax(const int32_t* global_ids, const float* scores, int count);
+
+/// One verifier parity's decode-only head on another GPU. The shared NativeHead must outlive this object.
+/// The producer writes exact Q8_1 rows to handoff(), then finishes its stream or records producer_ready. No P2P is required.
+/// Sampling with a history or logit bias stays on the caller's ordinary path.
+class DecodeHeadWindow {
+public:
+    DecodeHeadWindow() = default;
+    ~DecodeHeadWindow();
+    DecodeHeadWindow(const DecodeHeadWindow&) = delete;
+    DecodeHeadWindow& operator=(const DecodeHeadWindow&) = delete;
+
+    bool init(const NativeHead& target, int source_device, int n, int vocab, int max_t,
+              bool use_il, bool use_argmax, bool nan_guard, std::string& err, int row_begin = 0, int row_count = 0);
+    void* handoff() const { return handoff_source_; }
+    size_t row_bytes() const { return row_bytes_; }
+    bool capture_all(std::string& err);
+    /// A null sampler keeps the graph's greedy pick. Otherwise only history-free, bias-free sampling is accepted.
+    /// producer_ready, when supplied, must already be recorded after the producer's handoff writes.
+    bool launch(int t, const strata::kernels::SamplerParams* sampler, uint64_t counter, std::string& err,
+                cudaEvent_t producer_ready = nullptr);
+    /// False while in flight; false with err on a CUDA failure. Results remain valid until the next launch.
+    bool done(std::string& err);
+    const int32_t* picks() const { return out_host_; }
+    /// Partial heads return local ids and their original logits; full heads do not allocate scores.
+    const float* scores() const { return scores_host_; }
+    int row_begin() const { return row_begin_; }
+    int row_count() const { return vocab_; }
+    /// T * kNonfiniteBlocks words, or nullptr when the guard is disabled.
+    const uint32_t* nonfinite() const { return nf_host_; }
+    bool copy_logits(int row, float* host) const;
+
+private:
+    void reset() noexcept;
+    bool capture(int t, std::string& err);
+    const NativeHead* head_ = nullptr;
+    const void* weights_ = nullptr;
+    int device_ = -1, n_ = 0, vocab_ = 0, max_t_ = 0, last_t_ = 0;
+    int row_begin_ = 0;
+    bool partial_ = false;
+    bool use_il_ = false, argmax_ = false, nan_guard_ = false, live_ = false;
+    size_t row_bytes_ = 0;
+    void *handoff_host_ = nullptr, *handoff_source_ = nullptr, *handoff_target_ = nullptr;
+    void *q8_ = nullptr, *interleaved_ = nullptr, *arg_scratch_ = nullptr;
+    float* logits_ = nullptr;
+    int32_t *out_host_ = nullptr, *out_device_ = nullptr;
+    float *scores_host_ = nullptr, *scores_device_ = nullptr;
+    uint32_t *nf_host_ = nullptr, *nf_device_ = nullptr;
+    cudaStream_t stream_ = nullptr;
+    cudaEvent_t finished_ = nullptr;
+    std::vector<cudaGraphExec_t> graphs_;
+};
+
+}  // namespace strata::core
